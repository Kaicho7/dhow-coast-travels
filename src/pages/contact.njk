---
permalink: "/contact/index.html"
---
{% include "seo.njk" %}
{% include "header.njk" %}

<main class="content">
  <header class="page-header">
    <h1>Contact Dhow Coast Travels</h1>
    <p>WhatsApp-first booking. We respond within minutes during business hours (EAT, UTC+3).</p>
  </header>

  <section class="section section-gradient">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Get in Touch</span>
        <h2>Fastest Way to Reach Us</h2>
        <p class="section-subtitle">Choose your preferred channel — we'll get back to you within minutes during business hours.</p>
      </div>
      <div class="area-quick-picks" style="max-width: 900px; margin: 0 auto;">
        <article class="quick-pick reveal">
          <div class="quick-pick-image" style="background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);">
            <svg viewBox="0 0 64 64" fill="white" xmlns="http://www.w3.org/2000/svg"><path d="M56 8C59.3137 8 62 10.6863 62 14V50C62 53.3137 59.3137 56 56 56H8C4.68629 56 2 53.3137 2 50V14C2 10.6863 4.68629 8 8 8H16V6C16 2.68629 18.6863 0 22 0H42C45.3137 0 48 2.68629 48 6V8H56ZM18 6H42V8H18V6ZM56 14V50H8V14H16L22 20H42L48 14H56ZM32 40C36.4183 40 40 36.4183 40 32C40 27.5817 36.4183 24 32 24C27.5817 24 24 27.5817 24 32C24 36.4183 27.5817 40 32 40ZM32 26C29.2386 26 27 28.2386 27 31C27 33.7614 29.2386 36 32 36C34.7614 36 37 33.7614 37 31C37 28.2386 34.7614 26 32 26Z"/></svg>
          </div>
          <div class="quick-pick-content">
            <h3>WhatsApp (Fastest)</h3>
            <p>Message us directly for quotes, bookings, and questions. Pre-filled message ready.</p>
            <a href="https://wa.me/255672450934?text=I'd%20like%20to%20book%20a%20Zanzibar%20tour" target="_blank" rel="noopener" class="btn btn-accent">Open WhatsApp Chat</a>
          </div>
        </article>
        <article class="quick-pick reveal">
          <div class="quick-pick-image" style="background: linear-gradient(135deg, var(--dct-ocean) 0%, var(--dct-palm) 100%);">
            <svg viewBox="0 0 64 64" fill="white" xmlns="http://www.w3.org/2000/svg"><path d="M8 22C8 18.6863 10.6863 16 14 16H50C53.3137 16 56 18.6863 56 22V42C56 45.3137 53.3137 48 50 48H14C10.6863 48 8 45.3137 8 42V22ZM8 24V42H14L24 32H40L50 42H56V24H8Z" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="quick-pick-content">
            <h3>Email</h3>
            <p>For formal inquiries, group bookings, or documentation requests.</p>
            <a href="mailto:bookings@dhowcoasttravels.com" class="btn btn-primary">bookings@dhowcoasttravels.com</a>
          </div>
        </article>
        <article class="quick-pick reveal">
          <div class="quick-pick-image" style="background: linear-gradient(135deg, #b8860b 0%, var(--dct-spice) 100%);">
            <svg viewBox="0 0 64 64" fill="white" xmlns="http://www.w3.org/2000/svg"><circle cx="32" cy="32" r="20" stroke="white" stroke-width="2.5"/></svg>
          </div>
          <div class="quick-pick-content">
            <h3>Phone / SMS</h3>
            <p>Call or text during business hours (8 AM – 6 PM EAT).</p>
            <a href="tel:+255672450934" class="btn btn-secondary">+255 672 450 934</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Or Use This Form</span>
        <h2>Send a Message Here</h2>
        <p class="section-subtitle">Fill out the form and we'll reply via WhatsApp or email within 2 hours during business hours.</p>
      </div>
      <div style="max-width: 700px; margin: 0 auto;">
        <form class="contact-form" netlify name="booking-inquiry" method="POST" data-netlify="true">
          <input type="hidden" name="form-name" value="booking-inquiry">
          <div class="form-row">
            <div class="form-group">
              <label for="name">Your Name *</label>
              <input type="text" id="name" name="name" required>
            </div>
            <div class="form-group">
              <label for="email">Email *</label>
              <input type="email" id="email" name="email" required>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="phone">WhatsApp / Phone Number</label>
              <input type="tel" id="phone" name="phone" placeholder="+255 XXX XXX XXX">
            </div>
            <div class="form-group">
              <label for="travel-dates">Travel Dates</label>
              <input type="text" id="travel-dates" name="travel_dates" placeholder="e.g., 15–22 July 2026">
            </div>
          </div>
          <div class="form-group">
            <label for="interests">What Interests You? *</label>
            <select id="interests" name="interests" required>
              <option value="">Select...</option>
              <option value="tours">Day Tours (Stone Town, Spice, Marine, Nature)</option>
              <option value="transfers">Airport Transfers</option>
              <option value="packages">Multi-Day Packages</option>
              <option value="safaris">Mainland Safaris (Serengeti, Ngorongoro, etc.)</option>
              <option value="custom">Custom Itinerary</option>
              <option value="other">Other / Not Sure</option>
            </select>
          </div>
          <div class="form-group">
            <label for="group-size">Group Size</label>
            <select id="group-size" name="group_size">
              <option value="1">1 (Solo)</option>
              <option value="2">2 (Couple)</option>
              <option value="3-4">3–4 (Family / Small Group)</option>
              <option value="5-8">5–8 (Large Group)</option>
              <option value="9+">9+ (Event / Corporate)</option>
            </select>
          </div>
          <div class="form-group">
            <label for="message">Details, Special Requests, Questions</label>
            <textarea id="message" name="message" rows="5" placeholder="Any special occasions, dietary needs, accessibility requirements, specific hotels or activities..."></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-lg btn-full">Send Inquiry</button>
          <p class="form-note" style="text-align: center;">We'll reply via WhatsApp or email within 2 hours during business hours.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Our Office</span>
        <h2>Visit Us in Stone Town</h2>
      </div>
      <div class="area-quick-picks" style="max-width: 900px; margin: 0 auto;">
        <article class="quick-pick reveal">
          <div class="quick-pick-image">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="64" height="64" fill="currentColor" opacity="0.1"/><path d="M32 8C28.6863 8 26 10.6863 26 14V24H18V14C18 8.9706 21.9706 5 26 5C30.0294 5 34 8.9706 34 14V24H38V14C38 10.6863 35.3137 8 32 8ZM26 26V38H38V26H26ZM18 38H46V42H18V38Z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="quick-pick-content">
            <h3>Dhow Coast Travels</h3>
            <p>Dhow Coast Travels, Near Mbuzini Hospital, Mbuzini, Magharibi District, Mjini Magharibi, 71208, Zanzibar, Tanzania</p>
            <p style="margin-top: 0.5rem;">
              <a href="https://wa.me/255672450934" target="_blank" rel="noopener" style="color: var(--dct-ocean); font-weight: 500;">WhatsApp: +255 672 450 934</a><br>
              <a href="mailto:bookings@dhowcoasttravels.com" style="color: var(--dct-ocean); font-weight: 500;">bookings@dhowcoasttravels.com</a>
            </p>
          </div>
        </article>
        <article class="quick-pick reveal">
          <div class="quick-pick-image">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="64" height="64" fill="currentColor" opacity="0.1"/><circle cx="32" cy="32" r="20" stroke="currentColor" stroke-width="2.5"/><path d="M32 12V28M20 32H44" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
          </div>
          <div class="quick-pick-content">
            <h3>Find Us on Google Maps</h3>
            <p>Search "Stone Town, Zanzibar" — our office is in the historic centre, walking distance from Forodhani Gardens.</p>
            <a href="https://maps.google.com/?q=Stone+Town+Zanzibar" target="_blank" rel="noopener" class="btn btn-primary">Open in Google Maps</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="cta-content reveal">
      <h2>Quick Links to Popular Pages</h2>
      <div class="quick-link-grid">
        <a href="/tours/" class="quick-link">Browse All Tours</a>
        <a href="/transfers/" class="quick-link">Airport Transfers</a>
        <a href="/packages/" class="quick-link">Multi-Day Packages</a>
        <a href="/hotels/" class="quick-link">Where to Stay</a>
        <a href="/areas/" class="quick-link">Explore by Zone</a>
        <a href="/about/" class="quick-link">About Us</a>
      </div>
    </div>
  </section>
</main>

{% include "footer.njk" %}
