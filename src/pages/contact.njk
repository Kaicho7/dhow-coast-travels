{% include "seo.njk" %}
{% include "header.njk" %}

<main class="contact-page">
  <h1>Contact Us</h1>
  <p>Have a question or want to book a transfer, excursion, or safari? Fill out the form below and we’ll get back to you within 24 hours.</p>

  <form name="booking" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="booking-form">
    <input type="hidden" name="form-name" value="booking" />
    <p hidden><label>Don’t fill this out if you're human: <input name="bot-field" /></label></p>
    <label for="name">Full Name</label>
    <input type="text" id="name" name="name" required />

    <label for="email">Email</label>
    <input type="email" id="email" name="email" required />

    <label for="phone">Phone</label>
    <input type="tel" id="phone" name="phone" required placeholder="+255 655 830 226 or +255 672 450 934" />

    <label for="service">Service Type</label>
    <select id="service" name="service" required>
      <option value="">Select a service…</option>
      <option value="transfer">Airport Transfer</option>
      <option value="excursion">Island Excursion</option>
      <option value="safari">Tanzania Safari</option>
    </select>

    <label for="date">Preferred Date</label>
    <input type="date" id="date" name="date" required />

    <label for="message">Additional Details</label>
    <textarea id="message" name="message" rows="4"></textarea>

    <label for="whatsapp">WhatsApp</label>
    <input type="text" id="whatsapp" name="whatsapp" placeholder="+255 655 830 226" />

    <button type="submit" class="btn primary">Send Request</button>
  </form>

  <section class="contact-details">
    <h2>Our Office</h2>
    <p>P.O. Box 123, Zanzibar</p>
    <p>Phone: <a href="tel:+255655830226">+255 655 830 226</a> | <a href="tel:+255672450934">+255 672 450 934</a></p>
    <p>WhatsApp: <a href="https://wa.me/255655830226" target="_blank">Chat on WhatsApp</a></p>
    <p>Email: <a href="mailto:info@zanzibar-tourism.tz">info@zanzibar-tourism.tz</a></p>
    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1585.123456789!2d39.2026!3d-6.1659!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1825c0a0b0c0d0e1%3A0x123456789abcdef!2sZanzibar%20Tourism%20Board!5e0!3m2!1sen!2stz!4v1690000000000" width="100%" height="250" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
  </section>

</main>

