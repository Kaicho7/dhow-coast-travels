{% include "header.njk" %}

<main class="home">
  <section class="hero">
    <h1>Discover <span class="highlight">Zanzibar</span> – Beaches, Culture &amp; Adventure</h1>
    <p>Official portal for travel, tours, hotels, and safaris in Zanzibar.</p>
    <a href="/attractions/" class="btn primary">Explore Attractions</a>
    <a href="/tours/" class="btn secondary">Book a Tour</a>
  </section>

  <section class="quick-links">
    <div class="card">
      <h2>Top Attractions</h2>
      <p>Stone Town, Nungwi Beach, Jozani Forest, Prison Island, Spice Farm and more.</p>
      <a href="/attractions/" class="btn small">See All</a>
    </div>
    <div class="card">
      <h2>Best Hotels</h2>
      <p>Luxury resorts, boutique stays, and budget-friendly options.</p>
      <a href="/hotels/" class="btn small">View Hotels</a>
    </div>
    <div class="card">
      <h2>Exciting Tours</h2>
      <p>Snorkeling, spice tours, cultural day trips, and Tanzania mainland safaris.</p>
      <a href="/tours/" class="btn small">Browse Tours</a>
    </div>
  </section>

  <section class="stats">
    <div class="stat">
      <span class="number">5</span>
      <span class="label">Stars on TripAdvisor</span>
    </div>
    <div class="stat">
      <span class="number">120</span>
      <span class="label">Tours Booked Monthly</span>
    </div>
    <div class="stat">
      <span class="number">200+</span>
      <span class="label">Accommodations Listed</span>
    </div>
    <div class="stat">
      <span class="number">3</span>
      <span class="label">Safaris in Tanzania</span>
    </div>
  </section>

  <section class="latest-news">
    <h2>Latest News</h2>
    <article class="news-item">
      <h3>New Luxury Resort Opens on Nungwi Beach</h3>
