---
title: "Kizimkazi & Dimbani"
description: "South coast — dolphin watching capital, ancient mosque (12th century), and access to Menai Bay Conservation Area."
permalink: "/areas/kizimkazi/index.html"
---
{% include "seo.njk" %}
{% include "header.njk" %}

<main class="area-detail">
  <section class="area-hero" style="background: linear-gradient(135deg, var(--dct-ocean) 0%, var(--dct-palm) 100%);">
    <div class="area-hero-content">
      <div class="area-tags">
        <span class="area-tag">Unguja (Main Island)</span>
        <span class="area-tag">Dolphin Watching</span>
      </div>
      <h1>Kizimkazi / Dimbani</h1>
      <p class="area-description">South coast — dolphin watching capital, ancient mosque (12th century), and access to Menai Bay Conservation Area.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">At a Glance</span>
        <h2>Kizimkazi / Dimbani Quick Stats</h2>
      </div>
      <div class="stats-grid" style="max-width: 600px; margin: 0 auto;">
        <div class="stat-item reveal"><span class="stat-number">3</span><span class="stat-label">Partner Hotels</span></div>
        <div class="stat-item reveal"><span class="stat-number">1</span><span class="stat-label">Attractions</span></div>
        <div class="stat-item reveal"><span class="stat-number">2</span><span class="stat-label">Recommended Tours</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Where to Stay</span>
        <h2>Where to Stay in Kizimkazi / Dimbani</h2>
        <p class="section-subtitle">Boutique hotels and resorts in Kizimkazi / Dimbani. Click through for direct booking or contact us for referral rates.</p>
      </div>
      <div class="cards-grid hotel-grid">
{% for hotel in hotels %}
  {% if hotel.name in ["Fruit & Spice Wellness Resort", "Aya Beach Bungalows", "Kwanza Resort by SUNRISE", "The Residence Zanzibar"] %}
  <article class="card hotel-card reveal" data-tier="{{ hotel.tier }}" data-zone="{{ hotel.zone }}" data-island="{{ hotel.island }}">
    <div class="card-image" style="position:relative;">
      <img src="/images/{{ hotel.zone | zoneImg(hotel.name) }}" alt="{{ hotel.name }}" loading="lazy">
    <div class="card-content">
      <span class="card-badge badge-{{ hotel.tier | lower | replace('upper-', '') }}">{{ hotel.tier | capitalize }}</span>
      <h3 class="card-title"><a href="{{ hotel.website }}" target="_blank" rel="noopener">{{ hotel.name }}</a></h3>
      <p class="card-meta">{{ hotel.zone }}{% if hotel.zone %}, {% endif %}{{ hotel.island }} • {{ hotel.star_rating or "Ungraded" }}</p>
      {% if hotel.category %}<p class="card-description">{{ hotel.category }}</p>{% endif %}
      <div class="card-footer">
        <span class="card-price">{{ hotel.price_range or "Contact for rates" }}</span>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
          <a href="{{ hotel.website }}" target="_blank" rel="noopener" class="btn btn-primary btn-sm">View Website</a>
          {% if hotel.whatsapp %}
          <a href="https://wa.me/{{ hotel.whatsapp | replace('+', '') | replace(' ', '') }}" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">WhatsApp</a>
          {% endif %}
        </div>
      </div>
    </div>
  </article>
  {% endif %}
{% endfor %}
      </div>
    </div>
  </section>

  <section class="section section-gradient">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Attractions</span>
        <h2>Attractions in Kizimkazi / Dimbani</h2>
        <p class="section-subtitle">Local attractions, dive centers, and activity providers in Kizimkazi / Dimbani.</p>
      </div>
      <div class="cards-grid attraction-grid">
{% for attraction in attractions %}
  {% if attraction.name in ["Kizimkazi Dive & Dolphin", "Kizimkazi Mosque (oldest in East Africa)"] %}
  <article class="card attraction-card reveal" data-type="{{ attraction.category }}">
    <div class="card-image" style="position:relative;">
      <img src="/images/{{ attraction.name | attractionImg(attraction.category) }}" alt="{{ attraction.name }}" loading="lazy">
    <div class="card-content">
      <span class="card-badge badge-cultural">{{ attraction.type | attractionTypeLabel }}</span>
      <h3 class="card-title">{{ attraction.name }}</h3>
      <p class="card-meta">{{ attraction.zone }}, {{ attraction.island }}</p>
      {% if attraction.website %}
        <a href="{{ attraction.website }}" target="_blank" rel="noopener" class="btn btn-primary btn-sm">Visit Website</a>
      {% else %}
        <span class="btn btn-sm" style="color: var(--dct-gray); border: 1px solid var(--dct-gray-light);">No public website</span>
      {% endif %}
    </div>
  </article>
  {% endif %}
{% endfor %}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Tours</span>
        <h2>Recommended Tours from Kizimkazi / Dimbani</h2>
        <p class="section-subtitle">The best day tours and experiences starting from Kizimkazi / Dimbani.</p>
      </div>
      <div class="cards-grid tour-grid">
{% for tour in tours %}
  {% if tour.seo_slug in ["kizimkazi-dolphin-tour", "safari-blue"] %}
  <article class="card tour-card reveal" data-category="{{ tour.category }}">
    <div class="card-image" style="position:relative;">
      <img src="/images/{{ __slugMap[tour.seo_slug] or __slugMap[tour.slug] or 'excursions.png' }}" alt="{{ tour.title }}" loading="lazy">
    <div class="card-content">
      <span class="card-badge badge-{{ tour.category | lower }}">{{ tour.category }}</span>
      <h3 class="card-title"><a href="/tours/{{ tour.seo_slug }}/">{{ tour.title }}</a></h3>
      <p class="card-meta">{{ tour.duration }} • {{ tour.location }}</p>
      <p class="card-description">{{ tour.short_description }}</p>
      <div class="card-footer">
        <span class="card-price">{{ tour.price.display }} <span class="price-basis">per person</span></span>
        <a href="/tours/{{ tour.seo_slug }}/" class="btn btn-primary btn-sm">Details & Booking</a>
      </div>
    </div>
  </article>
  {% endif %}
{% endfor %}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container" style="text-align: center; max-width: 600px;">
      <div class="reveal">
        <h2 style="margin-bottom: 1rem;">Need an Airport Transfer?</h2>
        <p style="color: var(--dct-text-muted); margin-bottom: 1.5rem;">Private transfer from ZNZ Airport to Kizimkazi / Dimbani — fixed price, flight tracking, meet & greet included.</p>
        <a href="/transfers/" class="btn btn-primary btn-lg">View Transfer Options</a>
      </div>
    </div>
  </section>
</main>

{% include "footer.njk" %}
