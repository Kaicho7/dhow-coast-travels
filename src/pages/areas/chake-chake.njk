---
permalink: "/areas/chake-chake/index.html"
---
{% include "seo.njk" %}
{% include "header.njk" %}

<main class="area-detail">
  <section class="area-hero" style="background: linear-gradient(135deg, var(--dct-ocean) 0%, var(--dct-palm) 100%);">
    <div class="area-hero-content">
      <div class="area-tags">
        <span class="area-tag">Pemba Island</span>
      </div>
      <h1>Chake Chake (Pemba)</h1>
      <p class="area-description">Main town of Pemba Island — authentic Swahili culture, clove plantations, and access to Pemba's pristine dive sites.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">At a Glance</span>
        <h2>Chake Chake (Pemba) Quick Stats</h2>
      </div>
      <div class="stats-grid" style="max-width: 600px; margin: 0 auto;">
        <div class="stat-item reveal"><span class="stat-number">0</span><span class="stat-label">Partner Hotels</span></div>
        <div class="stat-item reveal"><span class="stat-number">2</span><span class="stat-label">Attractions</span></div>
        <div class="stat-item reveal"><span class="stat-number">1</span><span class="stat-label">Recommended Tours</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Where to Stay</span>
        <h2>Where to Stay in Chake Chake (Pemba)</h2>
        <p class="section-subtitle">Boutique hotels and resorts in Chake Chake (Pemba). Click through for direct booking or contact us for referral rates.</p>
      </div>
      <div class="cards-grid hotel-grid">
{% for hotel in hotels %}
  {% if hotel.name in ["Pemba Island Divers", "Pemba Dive Center"] %}
  <article class="card hotel-card reveal" data-tier="{{ hotel.tier }}" data-zone="{{ hotel.zone }}" data-island="{{ hotel.island }}">
    <div class="card-image" style="position:relative;">
      <img src="/images/{{ hotel.zone | zoneImg(hotel.name) }}" alt="{{ hotel.name }} — Zanzibar hotel" loading="lazy">
    <div class="card-content">
      <span class="card-badge badge-{{ hotel.tier | lower | replace('upper-', 'upper-') }}">{{ hotel.tier | capitalize }}</span>
      <h3 class="card-title"><a href="{{ hotel.website }}" target="_blank" rel="noopener">{{ hotel.name }}</a></h3>
      <p class="card-meta">{{ hotel.zone }}, {{ hotel.island }} • {{ hotel.star_rating or "Ungraded" }} star</p>
      {% if hotel.category %}<p class="card-description">{{ hotel.category }}</p>{% endif %}
      <div class="card-footer">
        <span class="card-price">{{ hotel.price_range or "Contact for rates" }}</span>
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
          <a href="{{ hotel.website }}" target="_blank" rel="noopener" class="btn btn-primary btn-sm">View Website</a>
          {% if hotel.whatsapp %}
          <a href="https://wa.me/{{ hotel.whatsapp | replace('+', '') | replace(' ', '') }}" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">WhatsApp</a>
          {% endif %}
        </div>
      </div>
    </div>
  </article>
  {% endif %}
{% endfor %}
      </div>
    </div>
  </section>

  <section class="section section-gradient">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Attractions</span>
        <h2>Attractions in Chake Chake (Pemba)</h2>
        <p class="section-subtitle">Local attractions, dive centers, and activity providers in Chake Chake (Pemba).</p>
      </div>
      <div class="cards-grid attraction-grid">
{% for attraction in attractions %}
  {% if attraction.name in ["Pemba Island Divers", "Pemba Dive Center"] %}
  <article class="card attraction-card reveal" data-type="{{ attraction.category }}">
    <div class="card-image" style="position:relative;">
      <img src="/images/{{ attraction.name | attractionImg(attraction.category) }}" alt="{{ attraction.name }} — Zanzibar" loading="lazy">
    <div class="card-content">
      <span class="card-badge badge-cultural">{{ attraction.type }}</span>
      <h3 class="card-title">{{ attraction.name }}</h3>
      <p class="card-meta">{{ attraction.zone }}, {{ attraction.island }}</p>
      {% if attraction.website %}
        <a href="{{ attraction.website }}" target="_blank" rel="noopener" class="btn btn-primary btn-sm">Visit Website</a>
      {% else %}
        <span class="btn btn-sm" style="color: var(--dct-gray); border: 1px solid var(--dct-gray-light);">No public website</span>
      {% endif %}
    </div>
  </article>
  {% endif %}
{% endfor %}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Tours</span>
        <h2>Recommended Tours from Chake Chake (Pemba)</h2>
        <p class="section-subtitle">The best day tours and experiences starting from Chake Chake (Pemba).</p>
      </div>
      <div class="cards-grid tour-grid">
{% for tour in tours %}
  {% if tour.seo_slug in ["serengeti-3day-flyin"] %}
  <article class="card tour-card reveal" data-category="{{ tour.category }}">
    <div class="card-image" style="position:relative;">
      <img src="/images/{{ __slugMap[tour.seo_slug] or __slugMap[tour.slug] or 'excursions.png' }}" alt="{{ tour.title }} — Zanzibar tour" loading="lazy">
    <div class="card-content">
      <span class="card-badge badge-{{ tour.category | lower }}">{{ tour.category }}</span>
      <h3 class="card-title"><a href="/tours/{{ tour.seo_slug }}/">{{ tour.title }}</a></h3>
      <p class="card-meta">{{ tour.duration }} • {{ tour.location }}</p>
      <p class="card-description">{{ tour.short_description }}</p>
      <div class="card-footer">
        <span class="card-price">{{ tour.price.display }} <span class="price-basis">per person</span></span>
        <a href="/tours/{{ tour.seo_slug }}/" class="btn btn-primary btn-sm">Details & Booking</a>
      </div>
    </div>
  </article>
  {% endif %}
{% endfor %}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container" style="text-align: center; max-width: 600px;">
      <div class="reveal">
        <h2 style="margin-bottom: 1rem;">Need an Airport Transfer?</h2>
        <p style="color: var(--dct-text-muted); margin-bottom: 1.5rem;">Private transfer from ZNZ Airport to Chake Chake (Pemba) — fixed price, flight tracking, meet & greet included.</p>
        <a href="/transfers/" class="btn btn-primary btn-lg">View Transfer Options</a>
      </div>
    </div>
  </section>
</main>

{% include "footer.njk" %}
