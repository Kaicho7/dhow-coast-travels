---
permalink: "/hotels/index.html"
---
{% include "seo.njk" %}
{% include "header.njk" %}

<main class="content">
  <header class="page-header">
    <h1>Where to Stay in Zanzibar — Hotels & Resorts</h1>
    <p class="page-meta">213 hand-picked hotels and resorts across all zones. Filter by tier, beach, or island. Book direct (we arrange negotiated referral rates) or use our WhatsApp-first booking service.</p>
  </header>

  <div class="filters-bar">
    <button class="filter-btn active" data-filter="all">All Tiers</button>
    <button class="filter-btn" data-filter="luxury">Luxury (5-Star)</button>
    <button class="filter-btn" data-filter="upper-mid">Upper Mid-Range (4-Star)</button>
    <button class="filter-btn" data-filter="mid">Mid-Range (3-Star)</button>
    <button class="filter-btn" data-filter="standard">Guest Houses & Budget</button>
  </div>

  <section class="cards-grid hotel-grid">
    {% for hotel in hotels %}
      <article class="card hotel-card reveal" data-tier="{{ hotel.tier }}" data-zone="{{ hotel.zone }}" data-island="{{ hotel.island }}">
        <div class="card-image image-placeholder">
          {% if hotel.tier == 'luxury' %}
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="64" height="64" fill="currentColor" opacity="0.1"/><path d="M32 8C28.6863 8 26 10.6863 26 14V24H18V14C18 8.9706 21.9706 5 26 5C30.0294 5 34 8.9706 34 14V24H38V14C38 10.6863 35.3137 8 32 8ZM26 26V38H38V26H26ZM18 38H46V42H18V38Z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="32" cy="48" r="4" stroke="currentColor" stroke-width="2"/></svg>
          {% elif hotel.tier == 'upper-mid' %}
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="64" height="64" fill="currentColor" opacity="0.1"/><path d="M32 8L14 30V50H50V30L32 8Z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="32" cy="22" r="6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {% elif hotel.tier == 'mid' %}
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="64" height="64" fill="currentColor" opacity="0.1"/><path d="M16 22L32 8L48 22V54H16V22Z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 34H48" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
          {% else %}
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="64" height="64" fill="currentColor" opacity="0.1"/><circle cx="32" cy="32" r="20" stroke="currentColor" stroke-width="2.5"/></svg>
          {% endif %}
          <button class="card-favorite" aria-label="Add to favorites">♡</button>
        </div>
        <div class="card-content">
          <span class="card-badge badge-{{ hotel.tier | lower | replace('upper-', 'upper-') }}">{{ hotel.tier | capitalize }}</span>
          <h3 class="card-title"><a href="{{ hotel.website }}" target="_blank" rel="noopener">{{ hotel.name }}</a></h3>
          <p class="card-meta">{{ hotel.zone }}, {{ hotel.island }} • {{ hotel.star_rating or 'Ungraded' }} star</p>
          {% if hotel.category %}<p class="card-description">{{ hotel.category }}</p>{% endif %}
          <div class="card-footer">
            <span class="card-price">{{ hotel.price_range or 'Contact for rates' }}</span>
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
              <a href="{{ hotel.website }}" target="_blank" rel="noopener" class="btn btn-primary btn-sm">View Website</a>
              {% if hotel.whatsapp %}
                <a href="https://wa.me/{{ hotel.whatsapp | replace('+', '') | replace(' ', '') }}" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">WhatsApp</a>
              {% endif %}
            </div>
          </div>
        </div>
      </article>
    {% else %}
      <p class="reveal">No properties found. Adjust your filters.</p>
    {% endfor %}
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">Travel Styles</span>
        <h2>Best Beaches for Your Travel Style</h2>
        <p class="section-subtitle">Each zone has a distinct personality. Match your vibe to the right beach.</p>
      </div>
      <div class="area-quick-picks">
        <article class="quick-pick reveal">
          <div class="quick-pick-image image-placeholder">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="64" height="64" fill="currentColor" opacity="0.1"/><path d="M32 8C28.6863 8 26 10.6863 26 14V24H18V14C18 8.9706 21.9706 5 26 5C30.0294 5 34 8.9706 34 14V24H38V14C38 10.6863 35.3137 8 32 8ZM26 26V38H38V26H26ZM18 38H46V42H18V38Z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="quick-pick-content">
            <h3>Nungwi & Kendwa — Nightlife & Watersports</h3>
            <p>Full-moon parties, kite surfing, scuba diving, sunset dhow cruises. Best for couples and groups who want action.</p>
          </div>
        </article>
        <article class="quick-pick reveal">
          <div class="quick-pick-image image-placeholder">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="64" height="64" fill="currentColor" opacity="0.1"/><path d="M12 42C12 37.5817 15.5817 34 20 34H44C48.4183 34 52 37.5817 52 42V46H12V42Z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="quick-pick-content">
            <h3>Paje & Jambiani — Kitesurfing & Adventure</h3>
            <p>World-class kitesurfing lagoon, Kuza Cave excursions, seaweed farm visits. Laid-back vibe with easy activity access.</p>
          </div>
        </article>
        <article class="quick-pick reveal">
          <div class="quick-pick-image image-placeholder">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="64" height="64" fill="currentColor" opacity="0.1"/><path d="M32 8C28.6863 8 26 10.6863 26 14V24H18V14C18 8.9706 21.9706 5 26 5C30.0294 5 34 8.9706 34 14V24H38V14C38 10.6863 35.3137 8 32 8ZM26 26V38H38V26H26ZM18 38H46V42H18V38Z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div class="quick-pick-content">
            <h3>Stone Town — Culture & History</h3>
            <p>Boutique hotels in UNESCO-listed buildings. Walk to markets, museums, and the seafront. Best for culture lovers.</p>
          </div>
        </article>
        <article class="quick-pick reveal">
          <div class="quick-pick-image image-placeholder">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="64" height="64" fill="currentColor" opacity="0.1"/><path d="M16 22L32 8L48 22V54H16V22Z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 34H48" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
          </div>
          <div class="quick-pick-content">
            <h3>Bwejuu & Michamvi — Luxury & Seclusion</h3>
            <p>Boutique resorts, private beaches, The Rock Restaurant nearby. Best for honeymooners and those seeking tranquility.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <p class="hotel-disclaimer reveal">* We partner with select properties for referral bookings. Contact us on WhatsApp for current availability and negotiated rates.</p>
</main>

{% include "footer.njk" %}