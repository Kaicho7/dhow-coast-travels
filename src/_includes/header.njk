    <span class="brand">Dhow Coast Travels</span>
    <span class="intent-indicator" id="intentIndicator"></span>
    <span class="contact"><a href="https://wa.me/255672450934" target="_blank" rel="noopener">+255 672 450 934</a></span>
  </div>
  <nav class="main-nav" id="mainNav">
    <a href="/" class="logo"><span>Dhow Coast Travels</span></a>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
      ☰
    </button>
    <ul class="nav-list">
      <li><a href="/" {% if page.url == '/' %}class="active"{% endif %}>Home</a></li>
      <li><a href="/tours/" {% if page.url == '/tours/' %}class="active"{% endif %}>Tours</a></li>
      <li><a href="/transfers/" {% if page.url == '/transfers/' %}class="active"{% endif %}>Transfers</a></li>
      <li><a href="/packages/" {% if page.url == '/packages/' %}class="active"{% endif %}>Packages</a></li>
      <li><a href="/hotels/" {% if page.url == '/hotels/' %}class="active"{% endif %}>Hotels</a></li>
      <li><a href="/attractions/" {% if page.url == '/attractions/' %}class="active"{% endif %}>Attractions</a></li>
      <li><a href="/areas/" {% if page.url == '/areas/' %}class="active"{% endif %}>Areas</a></li>
      <li><a href="/travel-guide/" {% if page.url == '/travel-guide/' %}class="active"{% endif %}>Travel Guide</a></li>
<li><a href="/about/" {% if page.url == '/about/' %}class="active"{% endif %}>About</a></li>
      <li><a href="/family-travel/" {% if page.url == '/family-travel/' %}class="active"{% endif %}>Family Travel</a></li>
      <li><a href="/honeymoon-packages/" {% if page.url == '/honeymoon-packages/' %}class="active"{% endif %}>Honeymoon Packages</a></li>
      <li><a href="/self-drive/" {% if page.url == '/self-drive/' %}class="active"{% endif %}>Self-Drive</a></li>
      <li><a href="/spice-farm-cultural/" {% if page.url == '/spice-farm-cultural/' %}class="active"{% endif %}>Spice Farm Cultural</a></li>
      <li><a href="/contact/" {% if page.url == '/contact/' %}class="active"{% endif %}>Contact</a></li>
    </ul>
  </nav>
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    const intentIndicators = {family: '👨‍👩‍👧‍👦', honeymoon: '💑', selfdrive: '🚗', migration: '🐋', health: '🏥', tribes: '🌿', packing: '🎒', spice: '🌿'};
    const path = window.location.pathname;
    if (path.includes('family-travel')) document.getElementById('intentIndicator').textContent = intentIndicators.family;
    else if (path.includes('honeymoon-packages')) document.getElementById('intentIndicator').textContent = intentIndicators.honeymoon;
    else if (path.includes('self-drive')) document.getElementById('intentIndicator').textContent = intentIndicators.selfdrive;
    else if (path.includes('migration-calendar')) document.getElementById('intentIndicator').textContent = intentIndicators.migration;
    else if (path.includes('health-safety')) document.getElementById('intentIndicator').textContent = intentIndicators.health;
    else if (path.includes('tribes-culture')) document.getElementById('intentIndicator').textContent = intentIndicators.tribes;
    else if (path.includes('packing-guide')) document.getElementById('intentIndicator').textContent = intentIndicators.packing;
    else if (path.includes('spice-farm-cultural')) document.getElementById('intentIndicator').textContent = intentIndicators.spice;
  });
  </script>
</header>