<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
{% set computedTitle = title or (page.fileSlug | replace("-", " ") | capitalize) %}
{% set pageTitle = (computedTitle + " | Dhow Coast Travels") if (computedTitle and not computedTitle.includes("Dhow Coast Travels")) else (title | default("Zanzibar Tours & Transfers | Dhow Coast Travels")) %}
{% set pageDesc = description | default("Book " + computedTitle + " with Dhow Coast Travels in Zanzibar. Clear pricing, verified local guides, and fast WhatsApp booking.") %}

{% set featured = page.inputPath | featuredImage %}
{% if featured.featuredImage != "default-tour-hero.jpg" %}
  {% set ogImage = "/images/" + featured.featuredImage %}
{% else %}
  {% set ogImage = "/images/og-image.png" %}
{% endif %}

{% set SITE_URL = site.url | default("https://dhowcoasttravel.netlify.app") | replace("http://", "https://") %}

<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ SITE_URL }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ SITE_URL }}{{ page.url }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:image" content="{{ SITE_URL }}{{ ogImage }}">
<meta property="og:site_name" content="Dhow Coast Travels">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<meta name="twitter:image" content="{{ SITE_URL }}{{ ogImage }}">

<link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
<link rel="icon" type="image/svg+xml" sizes="16x16" href="/images/favicon-16x16.svg">
<link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TourOperator",
  "name": "Dhow Coast Travels",
  "url": "{{ SITE_URL | safe }}",
  "logo": "{{ SITE_URL | safe }}/images/logo.png",
  "description": "Licensed Zanzibar tour operator offering tours, airport transfers, and multi-day packages. WhatsApp-first booking with transparent pricing including marine park fees.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Stone Town",
    "addressLocality": "Zanzibar",
    "addressCountry": "TZ"
  },
  "telephone": "+255 672 450 934",
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "-6.1659",
    "longitude": "39.2026"
  },
  "sameAs": [
    "https://wa.me/255672450934",
    "https://wa.me/255774600924",
    "https://facebook.com/dhowcoasttravels",
    "https://instagram.com/dhowcoasttravels"
  ],
  "priceRange": "$$",
  "currenciesAccepted": "USD, TZS",
  "paymentAccepted": "Cash, Mobile Money, Bank Transfer, Card (via link)"
}
</script>
