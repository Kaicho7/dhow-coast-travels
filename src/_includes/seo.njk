{% set pageTitle = title | default("Dhow Coast Travels – Licensed Zanzibar Tour Operator") %}
{% set pageDesc = description | default("Book Zanzibar tours, airport transfers, and packages with Dhow Coast Travels. Transparent pricing, marine fees included, WhatsApp-first booking. Stone Town based.") %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/images/og-image.png">
<meta property="og:site_name" content="Dhow Coast Travels">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<meta name="twitter:image" content="{{ site.url }}/images/og-image.png">

<script type="application/ld+json">
{{{
  "@context": "https://schema.org",
  "@type": "TourOperator",
  "name": "Dhow Coast Travels",
  "url": "{{ site.url }}",
  "logo": "{{ site.url }}/images/logo.png",
  "description": "Licensed Zanzibar tour operator offering tours, airport transfers, and multi-day packages. WhatsApp-first booking with transparent pricing including marine park fees.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Stone Town",
    "addressLocality": "Zanzibar",
    "addressCountry": "TZ"
  },
  "telephone": "+255-7XX-XXXXXXX",
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "-6.1659",
    "longitude": "39.2026"
  },
  "sameAs": [
    "https://wa.me/255672450934",
    "https://facebook.com/dhowcoasttravels",
    "https://instagram.com/dhowcoasttravels"
  ],
  "priceRange": "$$",
  "currenciesAccepted": "USD, TZS",
  "paymentAccepted": "Cash, Mobile Money, Bank Transfer, Card (via link)"
}| json }}
</script>